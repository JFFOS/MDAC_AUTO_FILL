{
  "manifest_version": 3,
  "name": "MDAC Auto-Fill",
  "version": "1.1.1",
  "description": "Save frequent travellers and auto-fill the Malaysia Digital Arrival Card (MDAC) form.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://imigresen-online.imi.gov.my/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MDAC Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": ["https://imigresen-online.imi.gov.my/mdac/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["traveller-form.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
